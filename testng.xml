<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Mobile Automation Test Suite" parallel="false" verbose="2">

    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <!-- Global Parameters (can be overridden via system properties or CI/CD) -->
    <parameter name="platformName" value="Android"/>
    <parameter name="automationName" value="UiAutomator2"/>
    <parameter name="appiumServerUrl" value="http://127.0.0.1:4723/"/>

    <test name="Card Manager Automation Tests" preserve-order="true">
        <!-- Packages will be scanned once application test cases are created -->
        <packages>
            <package name="tests.*"/>
        </packages>
    </test>

</suite>
